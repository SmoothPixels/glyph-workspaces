  "style.bar.workspaces": {"icon":"","label":"Workspace Style","description":"Pick how the Glyph Workspaces plugin draws your workspaces"},
  "style.bar.workspaces.pacman": {"icon":"󰮯","label":"Pac-Man","description":"Pac-Man travels to the focused workspace, eating the pellets on the way","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-style.sh)\" == \"pacman\" ]]","action":"omarchy bar set io.github.smoothpixels.glyph-workspaces style pacman"},
  "style.bar.workspaces.dots": {"icon":"󰝥","label":"Dots","description":"A filled dot per occupied workspace, a small one per empty workspace","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-style.sh)\" == \"dots\" ]]","action":"omarchy bar set io.github.smoothpixels.glyph-workspaces style dots"},
  "style.bar.workspaces.numbers": {"icon":"","label":"Numbers","description":"Workspace numbers, like the built-in widget","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-style.sh)\" == \"numbers\" ]]","action":"omarchy bar set io.github.smoothpixels.glyph-workspaces style numbers"},
  "style.bar.workspaces.glyph": {"icon":"","label":"Custom glyphs","description":"Your own two characters, one for occupied workspaces and one for empty","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-style.sh)\" == \"glyph\" ]]","action":"omarchy bar set io.github.smoothpixels.glyph-workspaces style glyph"},
  "style.bar.workspaces.eat": {"icon":"󰝥","label":"Eat pellets","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-setting.sh eat true)\" == \"true\" ]]","action":"omarchy bar set io.github.smoothpixels.glyph-workspaces eat \"$([[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-setting.sh eat true)\" == \"true\" ]] && echo false || echo true)\""},
  "style.bar.workspaces.ghost": {"icon":"󰊠","label":"Ghost","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-setting.sh ghost false)\" == \"true\" ]]","action":"omarchy bar set io.github.smoothpixels.glyph-workspaces ghost \"$([[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-setting.sh ghost false)\" == \"true\" ]] && echo false || echo true)\""},
  "style.bar.workspaces.scroll": {"icon":"󰅂","label":"Scroll to switch","checked":"[[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-setting.sh scroll false)\" == \"true\" ]]","action":"omarchy bar set io.github.smoothpixels.glyph-workspaces scroll \"$([[ \"$($HOME/.config/omarchy/plugins/io.github.smoothpixels.glyph-workspaces/tools/current-setting.sh scroll false)\" == \"true\" ]] && echo false || echo true)\""},
